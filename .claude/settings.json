{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs pnpm exec prettier --write --ignore-unknown"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"許可を求めています\" with title \"Claude Code\" subtitle \"Notification\" sound name \"Pop\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"完了しました\" with title \"Claude Code\" subtitle \"Stop\" sound name \"Blow\"'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run format:*)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec tsc -p tsconfig.json --noEmit *)",
      "Bash(pnpm view *)",
      "mcp__mantine__get_item_doc",
      "mcp__mantine__get_item_props",
      "mcp__mantine__list_items",
      "mcp__mantine__search_docs"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Read(wrangler.toml)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.dev.vars)",
      "Edit(wrangler.toml)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(.dev.vars)",
      "Write(wrangler.toml)",
      "Bash(cat *env*)",
      "Bash(cat *wrangler*)",
      "Bash(cat *.vars)"
    ]
  }
}
