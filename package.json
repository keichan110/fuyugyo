{
  "name": "fuyugyo",
  "version": "0.1.0",
  "description": "Fuyugyō - 運営管理システム",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint src test e2e playwright.config.ts 'scripts/worktree-*.{ts,mjs}' 'scripts/lib/{local-ports,worktree-lock}.ts'",
    "lint:fix": "eslint src test e2e playwright.config.ts 'scripts/worktree-*.{ts,mjs}' 'scripts/lib/{local-ports,worktree-lock}.ts' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}' 'e2e/**/*.ts' playwright.config.ts 'scripts/worktree-*.{ts,mjs}' 'scripts/lib/{local-ports,worktree-lock}.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}' 'e2e/**/*.ts' playwright.config.ts 'scripts/worktree-*.{ts,mjs}' 'scripts/lib/{local-ports,worktree-lock}.ts'",
    "test": "pnpm run test:scripts && vitest run",
    "test:coverage": "pnpm run test:scripts && vitest run --coverage --testTimeout=20000",
    "test:scripts": "node --test scripts/*.test.mjs .github/scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && pnpm run test:e2e:release",
    "test:e2e:release": "tsx e2e/prepare.ts && E2E_BUILT=1 playwright test",
    "test:e2e:smoke": "tsx e2e/prepare.ts && playwright test --grep @smoke",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fuyugyo --local",
    "db:studio": "drizzle-kit studio",
    "db:seed:auth": "tsx scripts/seed-local.ts",
    "db:seed:demo": "tsx scripts/seed-dev-data.ts",
    "cf-typegen": "wrangler types",
    "doctor": "npx react-doctor@latest",
    "worktree:setup": "bash scripts/worktree-setup.sh"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@mantine/carousel": "9.4.1",
    "@mantine/charts": "9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "9.4.1",
    "@mantine/form": "9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "9.4.1",
    "@mantine/schedule": "9.4.1",
    "@sentry/cloudflare": "^11.11.0",
    "@sentry/react": "^11.11.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.16",
    "dayjs": "^1.11.21",
    "drizzle-orm": "0.45.4",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "4.12.34",
    "jose": "6.2.3",
    "react": "19.2.9",
    "react-dom": "19.2.7",
    "recharts": "^3.9.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.3",
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@cloudflare/workers-types": "4.20260628.1",
    "@eslint/js": "9.39.4",
    "@faker-js/faker": "^10.5.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@libsql/client": "^0.17.4",
    "@playwright/test": "1.65.1",
    "@sentry/bundler-plugins": "^11.11.0",
    "@tanstack/router-cli": "1.167.17",
    "@tanstack/router-plugin": "1.168.18",
    "@types/node": "26.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.9",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.7.0",
    "japanese-holidays": "^1.0.10",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.9.10",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
