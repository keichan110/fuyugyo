{
  "name": "fuyugyo",
  "version": "0.1.0",
  "description": "Fuyugyō - 運営管理システム",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fuyugyo --local",
    "db:migrate:remote": "wrangler d1 migrations apply fuyugyo --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-local.ts",
    "db:seed:data": "node scripts/seed-dev-data.ts",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "9.4.1",
    "@mantine/form": "9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "9.4.1",
    "@mantine/schedule": "9.4.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.16",
    "dayjs": "^1.11.21",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "jose": "6.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.3",
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@cloudflare/workers-types": "4.20260628.1",
    "@eslint/js": "9.39.4",
    "@faker-js/faker": "^10.5.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@libsql/client": "^0.17.4",
    "@tanstack/router-cli": "1.167.17",
    "@tanstack/router-plugin": "1.168.18",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "japanese-holidays": "^1.0.10",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
