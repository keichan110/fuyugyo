# ローカル開発用。内容を .dev.vars にコピーして値を設定する（コミットしない）
# 非機密の既定値は wrangler.toml の [vars] を参照する
# D1 は DB バインディングで接続する

# 32文字以上のランダムな秘密鍵
# 生成例: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long
LINE_CHANNEL_SECRET=replace-with-your-line-channel-secret

# ローカルで上書きする非機密設定
# 本番 Sentry への通知を無効にする。検証時だけ検証用 DSN に置き換える。
SENTRY_DSN=""
APP_URL=http://localhost:5173
LINE_CHANNEL_ID=0000000000
JWT_EXPIRES_IN=2h
JWT_REFRESH_INTERVAL=15m
JWT_ABSOLUTE_EXPIRES_IN=7d
INVITE_DEFAULT_EXPIRES=168h

# LINE Developers のコールバック URL:
# http://localhost:5173/api/auth/line/callback
# 本番の secret 管理・リリース手順:
# docs/settings/database-migration-deployment.md
