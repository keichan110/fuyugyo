{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs pnpm exec prettier --write --ignore-unknown"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/quality-check.sh",
            "timeout": 180,
            "statusMessage": "typecheck / lint / format / doctor を実行中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run format:*)",
      "Bash(pnpm run doctor:*)",
      "Bash(npx react-doctor*)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec tsc -p tsconfig.json --noEmit *)",
      "Bash(pnpm view *)",
      "mcp__mantine__get_item_doc",
      "mcp__mantine__get_item_props",
      "mcp__mantine__list_items",
      "mcp__mantine__search_docs"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Read(wrangler.toml)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.dev.vars)",
      "Edit(wrangler.toml)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(.dev.vars)",
      "Write(wrangler.toml)",
      "Bash(cat *env*)",
      "Bash(cat *wrangler*)",
      "Bash(cat *.vars)"
    ]
  }
}
