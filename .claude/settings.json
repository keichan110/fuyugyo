{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs pnpm exec prettier --write --ignore-unknown"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"許可を求めています\" with title \"Claude Code\" subtitle \"Notification\" sound name \"Pop\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"完了しました\" with title \"Claude Code\" subtitle \"Stop\" sound name \"Blow\"'"
          },
          {
            "type": "command",
            "command": "tc_out=$(pnpm run typecheck 2>&1); tc_ec=$?; lint_out=$(pnpm run lint 2>&1); lint_ec=$?; fmt_out=$(pnpm run format:check 2>&1); fmt_ec=$?; if [ $tc_ec -ne 0 ] || [ $lint_ec -ne 0 ] || [ $fmt_ec -ne 0 ]; then { [ $tc_ec -ne 0 ] && printf '%s\\n' \"$tc_out\"; [ $lint_ec -ne 0 ] && printf '%s\\n' \"$lint_out\"; [ $fmt_ec -ne 0 ] && printf '%s\\n' \"$fmt_out\"; } >&2; exit 2; fi",
            "timeout": 120,
            "statusMessage": "typecheck / lint / format を実行中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run format:*)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec tsc -p tsconfig.json --noEmit *)",
      "Bash(pnpm view *)",
      "mcp__mantine__get_item_doc",
      "mcp__mantine__get_item_props",
      "mcp__mantine__list_items",
      "mcp__mantine__search_docs"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Read(wrangler.toml)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.dev.vars)",
      "Edit(wrangler.toml)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(.dev.vars)",
      "Write(wrangler.toml)",
      "Bash(cat *env*)",
      "Bash(cat *wrangler*)",
      "Bash(cat *.vars)"
    ]
  }
}
